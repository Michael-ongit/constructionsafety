# ---------------------------------------------------------------------------
# Copy this file to ".env" in the same folder and fill in real values.
# Never commit the real ".env" file. Values in quotes are optional --
# python-dotenv strips surrounding ' ' or " " automatically either way.
# ---------------------------------------------------------------------------

# --- SQL Server / SSMS -------------------------------------------------------
MSSQL_SERVER='ltc-cdp-prod-sql.database.windows.net'
MSSQL_DATABASE=' CDP_PROD_Quality'
# Leave both blank to use Windows/trusted authentication instead.
MSSQL_USERNAME='prodadmin1'
MSSQL_PASSWORD='cdp@2024'
MSSQL_DRIVER='ODBC Driver 18 for SQL Server'
MSSQL_ENCRYPT='yes'
MSSQL_TRUST_SERVER_CERT='yes'
MSSQL_CONN_TIMEOUT='10'
MSSQL_POOL_SIZE='8'
# Your 4 tables from SSMS. Leave blank to auto-discover every table instead.
MSSQL_INCLUDE_TABLES='safety_model,uauc_evidence,uauc_rejection_history,compliance_audit'

# --- OpenAI --------------------------------------------------------------------
# Works with either plain OpenAI or Azure OpenAI / Azure AI Foundry --
# just point OPENAI_BASE_URL at the right endpoint, Azure is auto-detected.
#
# Plain OpenAI:
#   OPENAI_BASE_URL='https://api.openai.com/v1'
#
# Azure (your endpoint):
OPENAI_API_KEY='I7ESQQQ3oVpr3JnFvtL4HZeNTivjhEAQMY5zK6pBr8gz2rglFZ65JQQJ99CCAC77bzfXJ3w3AAAAACOGVV6c'
OPENAI_BASE_URL='https://lnt-rbf-visionanalytics-foundry.cognitiveservices.azure.com/'
# On Azure these are your DEPLOYMENT names, not raw model names.
OPENAI_SQL_MODEL='gpt-4o'
OPENAI_CHAT_MODEL='gpt-4o'
AZURE_OPENAI_API_VERSION='2024-12-01-preview'
OPENAI_TIMEOUT_SECONDS='45'
OPENAI_MAX_RETRIES='2'

# --- Embeddings (schema + SQL cache) -------------------------------------------
# EMBED_DEVICE: 'cpu' (always works, default) | 'cuda' (force GPU) |
# 'auto' (use a GPU automatically if one is available, else CPU). GPU is
# entirely optional -- nothing here requires one.
EMBED_DEVICE='cpu'
EMBED_MODEL_NAME='all-MiniLM-L6-v2'
# How many highest-frequency values to store per column, uniformly across
# every column (no type-based grouping).
SCHEMA_TOP_N_VALUES='3'

# --- Retrieval / caching --------------------------------------------------------
TOP_K='2'
SQL_MAX_ROWS='25'
SQL_RETRY_ON_ERROR='true'
ENABLE_SQL_CACHE='true'
SQL_CACHE_SIMILARITY='0.92'

# --- API ------------------------------------------------------------------------
ALLOWED_ORIGINS='http://localhost:5176'
ADMIN_TOKEN='Mypassword@2026'
API_HOST='0.0.0.0'
API_PORT='8000'
