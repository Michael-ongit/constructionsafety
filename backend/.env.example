# Local SQLite backend
DB_BACKEND=sqlite
SQLITE_DB_PATH=local_dev.db
USE_SQLITE_FALLBACK=1

# Required by the API authentication module. Generate a new value for your machine.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Optional: required only for the chatbot's natural-language SQL features.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_SQL_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-4o-mini

# Local browser origins
ALLOWED_ORIGINS=http://localhost:5001,https://localhost:5001,http://localhost:3001

# YOLO models bundled in this backend directory. Relative paths resolve from backend.
YOLO_HELMET_MODEL=vest_model.pt
YOLO_POSE_MODEL=yolov8m-pose.pt
YOLO_PHONE_MODEL=yolov8n.pt
YOLO_VEST_MODEL=vest_model.pt
YOLO_ACTIVITY_MODEL=best.pt

# Optional integrations
SENDER_EMAIL=
SENDER_APP_PASSWORD=
EMAIL_NOTIFICATIONS_ENABLED=false
ONEDRIVE_CLIENT_ID=
ONEDRIVE_TENANT_ID=common
ONEDRIVE_REDIRECT_URI=http://localhost:3001/api/auth/onedrive/callback
